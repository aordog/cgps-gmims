$band="c";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
&makemos;

$band="d";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
&makemos;

$band="d";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
&makemos;

}

