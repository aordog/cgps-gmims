$mos="M"."$mosaics[$i][0]";
$moslc= lc $mos;
$long="$mosaics[$i][21]";
$lat="$mosaics[$i][22]";

chdir "/home/ordoga/DRAO_export/CG_W23/Mosaics/";
system("mkdir $mos");

$band="a";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
&makemos;

