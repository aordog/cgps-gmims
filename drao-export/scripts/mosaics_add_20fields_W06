#!/usr/bin/perl -w

# Adds the remaining fields to the ones collected in mosaics_ob20fields to bring it up to 20


@mosaics=(
["G2","ga2","ga7","ha2","ha7","f9","g4","g9","h4","g1","g6","h1","h6","f8","g3","g8","h3","g0","g5","h0","h5",104.75,3.0,1406.9,1413.8,1427.4,1434.3,1420.6]
);

$ap=chr(34);
$sap=chr(39);

for ($i = 0; $i <= 0; $i++) {

$mos="M"."$mosaics[$i][0]";
$moslc= lc $mos;

$band="a";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][23]";
&addmos;

$band="a";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][23]";
&addmos;

$band="b";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][24]";
&addmos;

$band="b";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][24]";
&addmos;

$band="c";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][25]";
&addmos;

$band="c";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][25]";
&addmos;

$band="d";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][26]";
&addmos;

$band="d";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][26]";
&addmos;
}




