print MADR3 "\n";  #! File name (max 52 chars) [EFF.
print MADR3 "\n";  #! Data type (IRD) [R]:
print MADR3 "\n";  #! Dimensions:
print MADR3 "\n";  #! Subset [NONE]:
print MADR3 "n\n";  #! Are "undefined" data allowed?
print MADR3 "\n";  #!    Data-unit type [4]:
print MADR3 "\n";  #!    Scaling factor [1.000]:
print MADR3 "\n";  #! Are the parameters that you en
print MADR3 "\n";  #! Define coordinates (astronomic
print MADR3 "\n";  #! Type of file (RD,RV,VD,UV,XY)
print MADR3 "\n";  #! Sky projection (SEGTVACF) [S]:
print MADR3 "\n";  #!    Epoch for projection (1950
print MADR3 "\n";  #! Select velocity-like coordinat
print MADR3 "\n";  #! RA of reference element [20H 5
print MADR3 "\n";  #! DEC of reference record [57D 1
print MADR3 "\n";  #! Reference ELEMENT for RA [513.
print MADR3 "\n";  #! Reference RECORD for DEC [513.
print MADR3 "\n";  #! DELTA "RA" per element (unsign
print MADR3 "\n";  #! DELTA "DEC" per record (unsign
print MADR3 "\n";  #! Define file (3rd dimension) co
print MADR3 "\n";  #! Define resolution (beam and ve
print MADR3 "\n";  #! Define auxiliary astronomical
print MADR3 "\n";  #! Central heliocentric frequency
print MADR3 "\n";  #! Stokes parameter [I] ("/?" = h
print MADR3 "\n";  #! Data-set bandwidth (MHz) [0.00
print MADR3 "\n";  #! Observation epoch (e.g. 1984.6
print MADR3 "\n";  #! Are the entered astrophysical
print MADR3 "\n";  #! Do you want a comment? [N]:
print MADR3 "\n";  #! ?>
print MADR3 "\n";  #! ?>
print MADR3 "exit\n";  #! ?>
close(MADR3);

#
# Copy final U map of field and Short Spacing Map over
#

chdir "../u";
open(MADR,"|madr");
print MADR "rdir\n";
print MADR "../../../../PRC_OB_PhD/"."$newdir"."/"."$band"."/u\n";
print MADR "rget f1\n";
print MADR "y\n";
print MADR "rdir\n";
print MADR "../../../../GMIMS_"."$band\n";
print MADR "rget f2\n";
print MADR "y\n";
print MADR "exit\n";
close(MADR);


#
# Regrid Short Spacing U Map
#

&posi;
print "RA : $pos_ra  DEC : $pos_dec\n";

open(MAPCONVRT, "|mapconvrt");
print MAPCONVRT "\n"; #! Do you wish to run in batch mo
print MAPCONVRT "\n";  #! Choice (LQCTSN) [C]:
print MAPCONVRT "\n";  #! Do you want to create a log? [
print MAPCONVRT "\n";  #! Choice (LQCTSN) [C]:
print MAPCONVRT "2\n";  #!   File definition number [DEFI
#print MAPCONVRT "y\n";  #! The angle reference frame for Q and U maps
print MAPCONVRT "\n";  #! Scaling factor (optional) for
print MAPCONVRT "\n";  #! Are input data values to be li
print MAPCONVRT "\n";  #!   File definition number [DEFI
print MAPCONVRT "gmims"."$band"."$field".".regr\n";  #! File name (max 52 chars) [] ("
