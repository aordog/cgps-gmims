#!/usr/bin/perl -w
#
# Prep the directories for adding GMIMS and CGPS polarization data.
# Adapted for GMIMS+CGPS, AO February, 2021
#
# This is for the 'OB' fields 
# RUN THIS IN THE PRC DIRECTORY
#
# Called by easy_fields_prep_GC_paper


print "Survey Lettercode?: ";
$survey1=<STDIN>;
chop($survey1);
print "Survey Number?: ";
$survey2=<STDIN>;
chop($survey2);
print "Registration Factor?: ";
$calib=<STDIN>;
chop($calib);

$survey1 = uc $survey1;
$field="$survey1"."$survey2";
$survey1 = lc $survey1;
$newdir="$survey1"."$survey2"."p21";

#
# Copy final polarization directory and create and populate subdirectories
#

system("mkdir ".$newdir);
system("chmod 755 *");
chdir "$newdir";
system("mkdir a");
system("mkdir b");
system("mkdir c");
system("mkdir d");

$band="a";
&qugal;
$band="b";
&qugal;
$band="c";
&qugal;
$band="d";
&qugal;

sub qugal {
chdir "/home/ordoga/DRAO_export/CG_W23/PRC/"."$newdir"."/"."$band";

system("mkdir q");
system("mkdir u");

#
# Copy final Q map of field and Short Spacing Map over
#

chdir "q";
open(MADR,"|madr");
print MADR "rdir\n";
print MADR "../../../../PRC_OB_PhD/"."$newdir"."/"."$band"."/q\n";
print MADR "rget f1\n";
print MADR "y\n";
print MADR "rdir\n";
print MADR "../../../../GMIMS_"."$band\n";
print MADR "rget f1\n";
print MADR "y\n";
print MADR "exit\n";
close(MADR);

#
# Regrid Short Spacing Q Map
#

&posi;
print "RA : $pos_ra  DEC : $pos_dec\n";

open(MAPCONVRT, "|mapconvrt");
print MAPCONVRT "\n"; #! Do you wish to run in batch mo
print MAPCONVRT "\n";  #! Choice (LQCTSN) [C]:
print MAPCONVRT "\n";  #! Do you want to create a log? [
print MAPCONVRT "\n";  #! Choice (LQCTSN) [C]:
print MAPCONVRT "2\n";  #!   File definition number [DEFI
#print MAPCONVRT "y\n";  #! The angle reference frame for Q and U maps
print MAPCONVRT "\n";  #! Scaling factor (optional) for
print MAPCONVRT "\n";  #! Are input data values to be li
print MAPCONVRT "\n";  #!   File definition number [DEFI
print MAPCONVRT "gmims"."$band"."$field".".regr\n";  #! File name (max 52 chars) [] ("
print MAPCONVRT "\n";  #! Data type (IRD) [R]:
print MAPCONVRT "1024 1024\n";  #! Basic element and record dimen
print MAPCONVRT "\n";  #!    Value to indicate "undefine
print MAPCONVRT "\n";  #! Are the parameters that you en
print MAPCONVRT "\n";  #! Sky projection (SEGTVACF) [S]:
print MAPCONVRT "\n";  #!    Epoch for projection (1950
print MAPCONVRT "$pos_ra\n";  #! RA of reference element [0H 0M
print MAPCONVRT "$pos_dec\n";  #! DEC of reference record [0D 0'
print MAPCONVRT "\n";  #! Reference ELEMENT for RA [513.
print MAPCONVRT "\n";  #! Reference RECORD for DEC [513.
print MAPCONVRT "0.33333'\n";  #! DELTA "RA" per element (unsign
print MAPCONVRT "0.33333'\n";  #! DELTA "DEC" per record (unsign
print MAPCONVRT "\n";  #! Are the entered astrophysical
print MAPCONVRT "n\n";  #! Do you want a comment? [N]:
print MAPCONVRT "\n";  #! Do you want to save this defin
print MAPCONVRT "\n";  #!   brightness-temperature scale
print MAPCONVRT "\n";  #! Is special rotation/expansion
close(MAPCONVRT);

#
# No No data values
#

open(MADR3, "|madr");
