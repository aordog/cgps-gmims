print MADRD "rdir\n";
print MADRD "../\n";
print MADRD "rget f7\n";
print MADRD "y\n";
print MADRD "rget f8\n";
print MADRD "y\n";
print MADRD "exit\n";
close(MADRD);

$band="a";
&qugal;
$band="b";
&qugal;
$band="c";
&qugal;
$band="d";
&qugal;

sub qugal {
chdir "../$band";

