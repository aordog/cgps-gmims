#!/usr/bin/perl -w
#
# Prep the directories for adding GMIMS and CGPS polarization data.
# Adapted for GMIMS+CGPS, AO February, 2021
#
# This is for the 'normal' fields 
# RUN THIS IN THE PRC DIRECTORY
# - easy_fields_prep_GC_paper changes to that director, so don't
#   need to worry about it.
# Called by easy_fields_prep_GC_paper

print "Survey Lettercode?: ";
$survey1=<STDIN>;
chop($survey1);
print "Survey Number?: ";
$survey2=<STDIN>;
chop($survey2);
print "Registration Factor?: ";
$calib=<STDIN>;
chop($calib);

$survey1 = uc $survey1;
$field="$survey1"."$survey2";
$survey1 = lc $survey1;
# reads in data from CGPS Archive directory stored on external drive:
$path = "/media/ordoga/ANNA/GRAD_SCHOOL_FILES/Data/Archive/$survey1"."/$survey2"."/p21";
$newdir="$survey1"."$survey2"."p21";

#
# Copy final polarization directory and create and populate subdirectories
#

system("cp -r $path"." $newdir");
system("chmod 755 *");
chdir "$newdir";
system("mkdir a");
system("mkdir b");
system("mkdir c");
system("mkdir d");

chdir "a";
open(MADRA,"|madr");
print MADRA "rdir\n";
print MADRA "../\n";
print MADRA "rget f1\n";
print MADRA "y\n";
print MADRA "rget f2\n";
print MADRA "y\n";
print MADRA "exit\n";
close(MADRA);

chdir "../b";
open(MADRB,"|madr");
print MADRB "rdir\n";
print MADRB "../\n";
print MADRB "rget f3\n";
print MADRB "y\n";
print MADRB "rget f4\n";
print MADRB "y\n";
print MADRB "exit\n";
