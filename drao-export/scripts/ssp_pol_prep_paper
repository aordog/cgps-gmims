print QUCONV "2\n";  #!   File definition number [DEFI
print QUCONV "g\n"; #!  Frame [E]:
print QUCONV "\n";  #!   File definition number [DEFI
print QUCONV "$field"."$band".".mq21gal\n";  #! File name (max 52 chars) [] ("
print QUCONV "\n";  #! Are the parameters that you en
print QUCONV "n\n"; #! Do you want a comment? [N]:
print QUCONV "\n";  #! Do you want to save this defin
print QUCONV "\n";  #!   File definition number [DEFI
