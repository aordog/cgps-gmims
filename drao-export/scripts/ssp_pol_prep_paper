sub calc {

open(MADRPROC,"|madr >> calc.LOG 2>&1") ||
	die "Could not run task madr - dying\n";

print MADRPROC "s f1\n";

close(MADRPROC);

open(TEMP,"calc.LOG") ||
	die "Could not open file calc.LOG - dying\n";

while (<TEMP>) {
	if (/Spatial res.:\s*(\d)'\s(\d*.\d*)"\s*x\s*(\d)'\s(\d*.\d*)"/) {
		$maj=(60*$1)+$2;
		$min=(60*$3)+$4;
		$ratio=$min/$maj;
		$freq=1420.406;
		$conv_factor=1.222e9/($freq*$freq*$maj*$min*$calib);
	} elsif (/File name:\s*(\w*)_\w*.(\d*)/) {
		$suffix=$1."_C21";
}
}


sub posi {
	open(MADR, "|madr >> madr.output 2>&1");
	print MADR "s f1\n";
	close(MADR);

	open(MADROUT, "madr.output") || 
		die "Could not open madr.output\n";

	$search_string="Reference coord.:   x: ";
	while (<MADROUT>) {
		if(/$search_string(.{14})\D+(.{13})/) {
			$pos_ra=$1;
			$pos_dec=$2;
		}
	}
	close(MADROUT);}

}
