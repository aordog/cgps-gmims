#NORMAL ONES:
#for ($i = 98; $i <= 127; $i++) {
for ($i = 0; $i <= 398; $i++) {
open(polprep,"|../scripts/ssp_pol_prep_paper");
print polprep "$fields[$i][0]\n";  #! "Survey Lettercode?: ";
print polprep "$fields[$i][1]\n";  #! "Survey Number?: ";
print polprep "$fields[$i][2]\n";  #! "Registration Factor?: ";
close(polprep);
}

#XQ ONES:
for ($i = 0; $i <= 6; $i++) {
#for ($i = 0; $i <= 1; $i++) {
open(polprep3,"|../scripts/ssp_pol_prep_xq_paper");
print polprep3 "$fields_xq[$i][0]\n";  #! "Survey Lettercode?: ";
print polprep3 "$fields_xq[$i][1]\n";  #! "Survey Number?: ";
print polprep3 "$fields_xq[$i][2]\n";  #! "Registration Factor?: ";
close(polprep3);
}

#ODD ONES:
for ($i = 0; $i <= 9; $i++) {
#for ($i = 0; $i <= 1; $i++) {
open(polprep4,"|../scripts/ssp_pol_prep2_paper");
print polprep4 "$fields_odd[$i][0]\n";  #! "Survey Lettercode?: ";
print polprep4 "$fields_odd[$i][1]\n";  #! "Survey Number?: ";
print polprep4 "$fields_odd[$i][2]\n";  #! "Registration Factor?: ";
close(polprep4);
}

#NEW OB ONES:
for ($i = 0; $i <= 17; $i++) {
#for ($i = 17; $i <= 17; $i++) {
open(polprep3,"|../scripts/ssp_pol_prep_OB_paper");
print polprep3 "$fields_OB[$i][0]\n";  #! "Survey Lettercode?: ";
print polprep3 "$fields_OB[$i][1]\n";  #! "Survey Number?: ";
print polprep3 "$fields_OB[$i][2]\n";  #! "Registration Factor?: ";
close(polprep3);
}
