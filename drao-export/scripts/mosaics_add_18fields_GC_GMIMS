#!/usr/bin/perl -w

# Adds the remaining fields to the ones collected in mosaics_ob18fields to bring it up to 18


@mosaics=(
["H2","ha2","ha7","h4","h9","i4","i9","h1","h6","i1","i6","h3","h8","i3","i8","h0","h5","i0","i5",100.75,3.0,1406.9,1413.8,1427.4,1434.3,1420.6],
["O2","n4","n9","o4","o4s","o9s","o6s","n6","o1","o6","p1","n3","n8","o3","o8","n5","o0","o5","p0",76.75,3.0,1406.9,1413.8,1427.4,1434.3,1420.6],
["EJ1","ej1","ej6","ek1","r8","ej3","ej8","ek3","ej0","ej5","ek0","ek5","r7","ej2","ej7","ek2","rr22","ob11","ob12",60.75,-1.0,1406.9,1413.8,1427.4,1434.3,1420.6],
["R2","ob10","sn02","sn01","q9","r4","r9","ej4","q6","r1","r6","ej1","q8","r3","r8","ej3","r0","r5","ej0",64.75,3.0,1406.9,1413.8,1427.4,1434.3,1420.6]
);

$ap=chr(34);
$sap=chr(39);

for ($i = 0; $i <= 3; $i++) {

$mos="M"."$mosaics[$i][0]";
$moslc= lc $mos;

$band="a";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][21]";
&addmos;

$band="a";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][21]";
&addmos;

$band="b";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][22]";
&addmos;

$band="b";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][22]";
&addmos;

$band="c";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][23]";
&addmos;

$band="c";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][23]";
&addmos;

$band="d";
$stokes="q";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][24]";
&addmos;

$band="d";
$stokes="u";
$filename="$moslc"."$band"."$stokes";
$freq="$mosaics[$i][24]";
&addmos;
}




