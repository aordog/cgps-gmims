sub transferfiles{

open(getfiles, "|madr");
print getfiles "rdir\n"; #!
print getfiles "../PRC/"."$field"."p21/"."$band"."/"."$stokes\n";#!
print getfiles "rget f5\n";
print getfiles "y\n";#!
print getfiles "rget f6\n";
print getfiles "y\n";#!
print getfiles "rget f7\n";
print getfiles "y\n";#!
print getfiles "rget f10\n";
print getfiles "y\n";#!
print getfiles "rget f11\n";
print getfiles "y\n";#!
print getfiles "rget f13\n";
print getfiles "y\n";#!
print getfiles "rget f14\n";
print getfiles "y\n";#!
print getfiles "\n";#!
print getfiles "exit\n"; #!
close(getfiles);

