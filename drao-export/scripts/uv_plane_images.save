sub makefits{

open(fitsanddelete, "|wfits");
print fitsanddelete "n\n"; # Do you want to create a log? [Y]: n
print fitsanddelete "\n"; # Are FITS images to be written to disk files? [Y]: 
print fitsanddelete "n\n"; #Are certain comments (<72 char) to be attached to all files in this run? [Y]: n
print fitsanddelete "1\n"; #Specify input files(s) for image data File definition number [DEFINE FILE]: 
print fitsanddelete "n\n"; #Do you have a particular header to use as a template? [N]: 
print fitsanddelete "n\n"; #Do you want to write a bare minimum header file? [N]: 
print fitsanddelete "\n"; #OBJECT name for image(s) [header entry]: 
print fitsanddelete "n\n"; #Are specific comments (<72 char) to be attached to this file? [Y]: n
print fitsanddelete "\n"; #Are data antenna-beam values? [N]: 
print fitsanddelete "d\n"; #Hit RETURN to examine header, any char to bypass further editing: d
print fitsanddelete "n\n"; #Do you want to save this header as a future template? [N]: 
print fitsanddelete "\n"; #Do you want to write header + image(s) now? [Y]: 
print fitsanddelete "f5_G_initial_uv_"."$field"."_"."$band"."$stokes".".fits\n"; #Name of the FITS disk output file?:
print fitsanddelete "y\n"; #Do you want to process another FITS header (+ image(s))? [Y]: n
